# syntax=docker/dockerfile:1.7

# kracht
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends guile; \
    zypper clean --all

COPY src/kracht ./src/kracht

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/kracht"; \
    cp -r "src/kracht/." "$site/kracht/"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="kracht" \
      org.opencontainers.image.description="Prelude of helper procedures for Guile Scheme" \
      org.opencontainers.image.url="https://github.com/jjba23/kracht" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site/3.0/kracht /usr/share/guile/site/3.0/kracht

ENTRYPOINT ["guile"]
